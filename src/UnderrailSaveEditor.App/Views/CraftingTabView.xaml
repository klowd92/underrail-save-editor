<UserControl x:Class="UnderrailSaveEditor.App.Views.CraftingTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UnderrailSaveEditor.App.Views">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12"
                BorderBrush="{DynamicResource AccentOrange}"
                BorderThickness="0,0,0,2"
                Padding="0,0,0,8">
            <Grid>
                <TextBlock Text="Crafting"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentOrange}"/>
                <TextBlock Text="Computed by the game's own blueprint code, with this character as the crafter"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Foreground="{DynamicResource TextSecondary}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: blueprints, then the component slots and requirements (like the game's window) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Height="26"/>
                    <TextBox Grid.Column="2" Text="{Binding BlueprintSearch, UpdateSourceTrigger=PropertyChanged}" Height="26"
                             ToolTip="Search blueprints"/>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredBlueprints}" SelectedItem="{Binding SelectedBlueprint}"
                         Background="#0A0A0A">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource AccentOrangeBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Padding="10,3" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverItemBrush}"/>
                                            </Trigger>
                                            <!-- The game highlights the chosen blueprint as an orange bar with dark text. -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentOrangeBrush}"/>
                                                <Setter Property="Foreground" Value="#0A0A0A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" FontSize="11" Opacity="0.6"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Component slots and requirements -->
                <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" Background="#121212"
                        BorderBrush="{DynamicResource BorderDim}" BorderThickness="1">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Slots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Solid frame = required slot, dashed frame = optional slot, dim = empty -->
                                    <Grid Width="200" Margin="4">
                                        <Rectangle x:Name="Frame" Stroke="{StaticResource AccentOrangeBrush}" StrokeThickness="2" RadiusX="3" RadiusY="3"/>
                                        <StackPanel Margin="10,8">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" Height="36"
                                                      MaxDropDownHeight="420" Padding="4,1">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,6,0"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding HasQuality, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Quality" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBox Text="{Binding Quality, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="24"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Optional}" Value="True">
                                            <Setter TargetName="Frame" Property="StrokeDashArray" Value="3 2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFilled}" Value="False">
                                            <Setter TargetName="Frame" Property="Stroke" Value="{StaticResource BorderLightBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Requirements}" Margin="4,10,0,0" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock x:Name="Req" Text="{Binding Text}" FontSize="14" Foreground="White"/>
                                        <TextBlock Text="{Binding HaveText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Met}" Value="False">
                                            <Setter TargetName="Req" Property="Foreground" Value="#E04040"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right: the resulting item, as the game's tooltip -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0A0A0A" BorderBrush="{DynamicResource AccentOrange}" BorderThickness="2" Padding="14,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <DockPanel>
                            <Image DockPanel.Dock="Left" VerticalAlignment="Top" Source="{Binding ResultIcon}" Visibility="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}" Width="50" Height="50"
                                   Margin="0,0,12,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <views:RichTextView RichText="{Binding ResultTooltip}"/>
                        </DockPanel>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="2,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="#E04040"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource OrangeButton}" MinWidth="100" Margin="0,0,10,0"/>
                    <Button Content="Create" Command="{Binding CreateCommand}" Style="{StaticResource OrangeButton}" MinWidth="160"
                            ToolTip="Add the crafted item to the character's bag"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
