<UserControl x:Class="UnderrailSaveEditor.App.Views.SkillsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Skills by category on the left; the game's description of the clicked skill on the right (like the game's skill screen). -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,16"
                BorderBrush="{DynamicResource AccentOrange}"
                BorderThickness="0,0,0,2"
                Padding="0,0,0,8">
            <Grid>
                <TextBlock Text="Skills" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Base value · (effective value with bonuses) · click a skill for details"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.75"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SkillCategories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding CategoryName}" FontSize="15" FontWeight="SemiBold" Opacity="0.8" Margin="8,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Skills}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Padding="12,5" Margin="0,0,6,3" CornerRadius="2"
                                                Background="{StaticResource GameItemBrush}"
                                                BorderBrush="{StaticResource GameItemBorderBrush}" BorderThickness="2"
                                                Cursor="Hand"
                                                PreviewMouseLeftButtonDown="OnSkillRowClicked">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="170"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         HorizontalContentAlignment="Center" Height="28"/>
                                                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.8"
                                                           Text="{Binding EffectiveValue, StringFormat=({0})}"
                                                           Visibility="{Binding HasBonus, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                    <Button Content="−" Width="28" Height="28" Margin="0,0,4,0" Style="{StaticResource SmallButton}"
                                                            Command="{Binding DataContext.DecrementSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="+" Width="28" Height="28" Style="{StaticResource SmallButton}"
                                                            Command="{Binding DataContext.IncrementSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentOrangeHoverBrush}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Selected skill -->
        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource GamePanelBrush}"
                BorderBrush="{DynamicResource AccentOrange}" BorderThickness="2" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding DetailTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" FontSize="15" LineHeight="22"/>
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding DetailAbilities, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Empty}">
                        <TextBlock Text="Related base ability" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextWhite}"/>
                        <TextBlock Text="{Binding DetailAbilities}" FontSize="15" Margin="12,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding DetailSynergies, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Empty}">
                        <TextBlock Text="Synergies" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextWhite}"/>
                        <TextBlock Text="{Binding DetailSynergies}" FontSize="15" Margin="12,2,0,0" LineHeight="22"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer with remaining points -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0"
                BorderBrush="{DynamicResource AccentOrange}"
                BorderThickness="0,2,0,0"
                Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Remaining points" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding RemainingPoints, FallbackValue=0}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextWhite}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
