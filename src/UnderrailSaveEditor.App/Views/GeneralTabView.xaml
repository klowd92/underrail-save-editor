<UserControl x:Class="UnderrailSaveEditor.App.Views.GeneralTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16"
                BorderBrush="{DynamicResource AccentOrange}"
                BorderThickness="0,0,0,2"
                Padding="0,0,0,8">
            <TextBlock Text="Character Information"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentOrange}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Character Identity Section -->
                <Border Background="{DynamicResource BackgroundMedium}"
                        BorderBrush="{DynamicResource BorderDim}"
                        BorderThickness="1"
                        Margin="0,0,0,16"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Name -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name"
                                   VerticalAlignment="Center" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding CharacterName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" Height="28"/>

                        <!-- Gender -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Gender"
                                   VerticalAlignment="Center" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  SelectedItem="{Binding Gender}"
                                  ItemsSource="{Binding GenderOptions}"
                                  Margin="0,0,0,12" Height="28" Width="120" HorizontalAlignment="Left"/>

                        <!-- Level -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Level"
                                   VerticalAlignment="Center" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left"
                                 Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" Height="28"/>

                        <!-- Experience -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Experience"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                                 Text="{Binding Experience, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"/>

                        <!-- Portrait, changeable like on the game's character creation screen -->
                        <StackPanel Grid.Row="0" Grid.RowSpan="4" Grid.Column="2" Margin="32,0,0,0" HorizontalAlignment="Left">
                            <Border Width="150" Height="150" Background="#0A0A0A"
                                    BorderBrush="{DynamicResource AccentOrange}" BorderThickness="2" CornerRadius="2">
                                <Image Source="{Binding Portrait}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button Content="◀" Width="30" Height="26" Margin="0,0,8,0" Style="{StaticResource SmallButton}"
                                        Command="{Binding PreviousPortraitCommand}" ToolTip="Previous portrait"/>
                                <Button Content="▶" Width="30" Height="26" Style="{StaticResource SmallButton}"
                                        Command="{Binding NextPortraitCommand}" ToolTip="Next portrait"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PortraitName}" FontSize="11.5" Opacity="0.75" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Available Points Section -->
                <TextBlock Text="Available Points"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentOrange}"
                           Margin="0,0,0,12"/>

                <Border Background="{DynamicResource BackgroundMedium}"
                        BorderBrush="{DynamicResource BorderDim}"
                        BorderThickness="1"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Skill Points -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Skill Points"
                                   VerticalAlignment="Center" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding SkillPoints, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Center"
                                 Margin="0,0,8,12" Height="28"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="+"
                                Width="28" Height="28"
                                Style="{StaticResource SmallButton}"
                                Command="{Binding IncrementSkillPointsCommand}"
                                Margin="0,0,4,12"/>
                        <Button Grid.Row="0" Grid.Column="3" Content="-"
                                Width="28" Height="28"
                                Style="{StaticResource SmallButton}"
                                Command="{Binding DecrementSkillPointsCommand}"
                                Margin="0,0,0,12"/>

                        <!-- Feat Points -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Feat Points"
                                   VerticalAlignment="Center" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding FeatPoints, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Center"
                                 Margin="0,0,8,12" Height="28"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="+"
                                Width="28" Height="28"
                                Style="{StaticResource SmallButton}"
                                Command="{Binding IncrementFeatPointsCommand}"
                                Margin="0,0,4,12"/>
                        <Button Grid.Row="1" Grid.Column="3" Content="-"
                                Width="28" Height="28"
                                Style="{StaticResource SmallButton}"
                                Command="{Binding DecrementFeatPointsCommand}"
                                Margin="0,0,0,12"/>

                        <!-- Ability Points -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ability Points"
                                   VerticalAlignment="Center" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding AbilityPoints, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Center"
                                 Margin="0,0,8,12" Height="28"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="+"
                                Width="28" Height="28"
                                Style="{StaticResource SmallButton}"
                                Command="{Binding IncrementAbilityPointsCommand}"
                                Margin="0,0,4,12"/>
                        <Button Grid.Row="2" Grid.Column="3" Content="-"
                                Width="28" Height="28"
                                Style="{StaticResource SmallButton}"
                                Command="{Binding DecrementAbilityPointsCommand}"
                                Margin="0,0,0,12"/>

                        <!-- Specialization Points -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Specialization Points"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding SpecializationPoints, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Center"
                                 Margin="0,0,8,0" Height="28"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="+"
                                Width="28" Height="28"
                                Style="{StaticResource SmallButton}"
                                Command="{Binding IncrementSpecPointsCommand}"
                                Margin="0,0,4,0"/>
                        <Button Grid.Row="3" Grid.Column="3" Content="-"
                                Width="28" Height="28"
                                Style="{StaticResource SmallButton}"
                                Command="{Binding DecrementSpecPointsCommand}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
