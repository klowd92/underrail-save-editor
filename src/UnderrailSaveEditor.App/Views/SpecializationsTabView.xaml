<UserControl x:Class="UnderrailSaveEditor.App.Views.SpecializationsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Laid out like the game's Specialization screen: "name  points / max  [-][+]" rows, description on the right. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource GamePanelBrush}"
                BorderBrush="{DynamicResource AccentOrange}" BorderThickness="2" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox Grid.Row="0" ItemsSource="{Binding FilteredSpecializations}" SelectedItem="{Binding Selected}"
                         BorderThickness="0" Background="Transparent" Padding="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="4,1,6,1"/>
                            <Setter Property="Margin" Value="2,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,8,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding DisplayName}" FontSize="15"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.7"/>
                                <TextBlock x:Name="Points" Grid.Column="2" Text="{Binding PointsText}" FontSize="15"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="−" Width="26" Height="26" Margin="0,0,4,0" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.DecrementPointsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="+" Width="26" Height="26" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.IncrementPointsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Name" Property="Opacity" Value="1"/>
                                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="Points" Property="Opacity" Value="1"/>
                                    <Setter TargetName="Points" Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Grid.Row="1" Margin="4,8,4,6">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                </DockPanel>
                <CheckBox Grid.Row="2" Margin="4,0,0,2" Content="Show all" IsChecked="{Binding ShowAll}"
                          FontSize="15" FontWeight="SemiBold"
                          ToolTip="Also show specializations of feats the character doesn't have"/>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource GamePanelBrush}"
                BorderBrush="{DynamicResource AccentOrange}" BorderThickness="2" Padding="16">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <Image DockPanel.Dock="Left" Source="{Binding DetailIcon}" Visibility="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}" Width="50" Height="50" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock Text="{Binding DetailTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding DetailFacts}" TextWrapping="Wrap" Opacity="0.75" Margin="0,12,0,0"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" FontSize="16" LineHeight="24"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="4,12,0,0">
            <TextBlock Text="Remaining points" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
            <TextBlock Text="{Binding RemainingPoints, FallbackValue=0}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextWhite}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ActiveSpecCount, StringFormat=Specializations with points: {0}}" FontSize="14" Opacity="0.75"
                       VerticalAlignment="Center" Margin="40,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
