<UserControl x:Class="UnderrailSaveEditor.App.Views.InventoryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UnderrailSaveEditor.App.Views">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12"
                BorderBrush="{DynamicResource AccentOrange}"
                BorderThickness="0,0,0,2"
                Padding="0,0,0,8">
            <Grid>
                <TextBlock Text="Inventory"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentOrange}"/>
                <TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Foreground="{DynamicResource TextSecondary}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Character items -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}"
                         SelectionChanged="OnItemSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="4,2,10,2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="33" Height="33" Margin="0,0,8,0"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ItemName" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Location}" FontSize="11.5" Opacity="0.75"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Details}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           FontWeight="SemiBold"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEquipped}" Value="True">
                                    <Setter TargetName="ItemName" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Tooltip, item edits, add from library -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding TooltipCaption}" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextSecondary}"/>

                <!-- Game-style tooltip panel -->
                <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="{DynamicResource AccentOrange}" BorderThickness="2" Padding="14,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <DockPanel>
                            <Image DockPanel.Dock="Left" VerticalAlignment="Top" Source="{Binding TooltipIcon}" Visibility="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}" Width="50" Height="50"
                                   Margin="0,0,12,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <views:RichTextView RichText="{Binding Tooltip}"/>
                        </DockPanel>
                    </ScrollViewer>
                </Border>

                <!-- Edit selected item -->
                <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" Background="{DynamicResource BackgroundMedium}"
                        BorderBrush="{DynamicResource BorderDim}" BorderThickness="1"
                        IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}">
                    <WrapPanel>
                        <TextBlock Text="Stacks" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Text="{Binding EditStacks, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="26" Margin="0,0,14,0"
                                 IsEnabled="{Binding CanEditStacks}"/>
                        <TextBlock Text="Quality" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Text="{Binding EditQuality, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="26" Margin="0,0,14,0"
                                 IsEnabled="{Binding CanEditQuality}"/>
                        <TextBlock Text="Durability" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Text="{Binding EditDurability, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="26" Margin="0,0,4,0"
                                 IsEnabled="{Binding CanEditDurability}"/>
                        <Button Content="Max" Command="{Binding RepairCommand}" Style="{StaticResource SmallButton}" Width="40" Height="26" Margin="0,0,14,0"/>
                        <Button Content="Apply" Command="{Binding ApplyCommand}" Style="{StaticResource GreenButton}" MinWidth="80" Margin="0,0,8,0"/>
                        <Button Content="Remove" Command="{Binding RemoveCommand}" Style="{StaticResource RedButton}" MinWidth="80"/>
                    </WrapPanel>
                </Border>

                <!-- Add from the game's item library -->
                <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" Background="{DynamicResource BackgroundMedium}"
                        BorderBrush="{DynamicResource BorderDim}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="140"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Add item:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource AccentOrange}" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding LibrarySearch, UpdateSourceTrigger=PropertyChanged}" Height="26"
                                     ToolTip="Search the game's item library by name or path"/>
                        </DockPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding LibraryResults}" SelectedItem="{Binding SelectedLibraryItem}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="4,1,8,1"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Image DockPanel.Dock="Left" Source="{Binding IconName, Converter={StaticResource IconConverter}}"
                                               Width="24" Height="24" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Opacity="0.75" FontSize="11.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Quantity" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBox Text="{Binding AddQuantity, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="26" Margin="0,0,14,0"/>
                            <TextBlock Text="Quality" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBox Text="{Binding AddQuality, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="26" Margin="0,0,14,0"
                                     IsEnabled="{Binding AddHasQuality}"/>
                            <Button Content="Add to bag" Command="{Binding AddCommand}" Style="{StaticResource OrangeButton}" MinWidth="110"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
