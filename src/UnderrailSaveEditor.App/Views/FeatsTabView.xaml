<UserControl x:Class="UnderrailSaveEditor.App.Views.FeatsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Laid out like the game's Feats screen: icon list on the left, description of the selected feat on the right. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Feat list, filter and "show all" -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource GamePanelBrush}"
                BorderBrush="{DynamicResource AccentOrange}" BorderThickness="2" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox Grid.Row="0" ItemsSource="{Binding FilteredFeats}" SelectedItem="{Binding SelectedFeat}"
                         BorderThickness="0" Background="Transparent" Padding="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="4,2,10,2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,10,0"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding DisplayName}" FontSize="16"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.7"/>
                                <CheckBox Grid.Column="2" IsChecked="{Binding IsActive}" VerticalAlignment="Center"
                                          ToolTip="The character has this feat"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="Name" Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Grid.Row="1" Margin="4,8,4,6">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                </DockPanel>
                <CheckBox Grid.Row="2" Margin="4,0,0,2" Content="Show all feats" IsChecked="{Binding ShowAllFeats}"
                          FontSize="15" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Selected feat -->
        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource GamePanelBrush}"
                BorderBrush="{DynamicResource AccentOrange}" BorderThickness="2" Padding="16">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <Image DockPanel.Dock="Left" Source="{Binding DetailIcon}" Visibility="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}" Width="66" Height="66" Margin="0,0,14,0"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock Text="{Binding DetailTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <Button DockPanel.Dock="Bottom" Content="{Binding ToggleText}" Command="{Binding ToggleSelectedCommand}"
                        Style="{StaticResource OrangeButton}" HorizontalAlignment="Right" MinWidth="150" Margin="0,12,0,0"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding DetailFacts}" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"/>
                <!-- Requirements, as the game lists them; unmet ones in red -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"
                            Visibility="{Binding DetailRequirements.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <TextBlock Text="Requirements:" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextWhite}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding DetailRequirements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,1">
                                    <TextBlock x:Name="Mark" Text="{Binding Mark}" Width="20" FontSize="15" Foreground="{StaticResource AccentGreenBrush}"/>
                                    <TextBlock x:Name="Line" Text="{Binding Text}" FontSize="15"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUnmet}" Value="True">
                                        <Setter TargetName="Mark" Property="Foreground" Value="#E04040"/>
                                        <Setter TargetName="Line" Property="Foreground" Value="#E04040"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" FontSize="16" LineHeight="24"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="4,12,0,0">
            <TextBlock Text="Remaining feats" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
            <TextBlock Text="{Binding RemainingFeatPoints, FallbackValue=0}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextWhite}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ActiveFeatCount, StringFormat=Active feats: {0}}" FontSize="14" Opacity="0.75"
                       VerticalAlignment="Center" Margin="40,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
